# Sn1p3rNetX v3.0 — Environment Configuration
# Copy this file to .env and fill in your values
# Usage: cp .env.example .env

# ── AI / LLM (Required for AI analysis) ──────────────────────────────────────
# Get your free Groq key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenAI fallback (if Groq is unavailable)
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: NVD API key for live CVE lookups (free at https://nvd.nist.gov/developers/request-an-api-key)
# NVD_API_KEY=your_nvd_api_key_here

# ── Scan Settings ──────────────────────────────────────────────────────────────
# SNX_SCAN_MODE=tcp          # tcp | udp | both
# SNX_THREADS=20             # concurrent scan threads
# SNX_TIMEOUT=120            # seconds per host

# ── Reporting ──────────────────────────────────────────────────────────────────
# SNX_REPORT_DIR=reports/output   # output directory for JSON/PDF/HTML reports

# ── AI Tuning ─────────────────────────────────────────────────────────────────
# SNX_AI_MAX_TOKENS=2500
# SNX_AI_TEMPERATURE=0.3
# SNX_AI_RETRIES=3

# ── Logging ────────────────────────────────────────────────────────────────────
# SNX_LOG_FILE=sn1p3rnetx.log
# SNX_LOG_LEVEL=INFO        # DEBUG | INFO | WARNING | ERROR
